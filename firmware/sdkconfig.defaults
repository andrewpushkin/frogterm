# reTerminal E1002: ESP32-S3, 32 MB flash, 8 MB octal PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# App data (JSON trees, photo list, calendars) goes to PSRAM: small allocations
# in internal RAM starved the Wi-Fi driver (ESP_ERR_NO_MEM in phy_track_pll_init).
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=16384
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
# TLS buffers in PSRAM, Mozilla CA bundle for HTTPS
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
CONFIG_LWIP_SNTP_MAX_SERVERS=1
# Speed (less time awake = more battery): fastest CPU, no PSRAM self-test,
# no image re-check when waking from deep sleep.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_SPIRAM_MEMTEST=n
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
# Faster Wi-Fi rejoin: reuse the last DHCP lease (REQUEST instead of DISCOVER).
CONFIG_LWIP_DHCP_RESTORE_LAST_IP=y
# Thread stacks (download threads, jpeg-decoder's worker threads) may live in
# PSRAM: internal RAM is too small for ~12 concurrent stacks.
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
# Firmware updates from the settings page: a new firmware that does not
# confirm itself (a planned deep sleep) is rolled back at the next restart.
# The bootloader built with these settings is flashed (Makefile).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
